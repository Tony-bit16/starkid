<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 在线菜谱搜索需要访问 HTTPS 接口。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 13（API 33）起，到期提醒通知需要运行时授权。
      未授权时仅停止推送，不影响食材列表与保质期状态展示。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      伴生看板只读访问食材数据的 signature 权限。
      只有与主 App 使用同一签名安装的 APK 才会被系统授予，避免任意应用读取库存。
    -->
    <permission
        android:name="com.fridge.main.permission.READ_INGREDIENTS"
        android:protectionLevel="signature" />
    <permission
        android:name="com.fridge.main.permission.WRITE_INGREDIENTS"
        android:protectionLevel="signature" />

    <application
        android:name=".FridgeApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 只读数据通道：看板通过 ContentResolver 查询，不能直接打开 Room 文件。 -->
        <provider
            android:name=".provider.IngredientContentProvider"
            android:authorities="com.fridge.main.provider"
            android:exported="true"
            android:readPermission="com.fridge.main.permission.READ_INGREDIENTS"
            android:writePermission="com.fridge.main.permission.WRITE_INGREDIENTS" />
    </application>

</manifest>
